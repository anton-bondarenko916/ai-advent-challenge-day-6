# ============================================================
# DeepSeek Chat — пример файла конфигурации (.env)
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
# ============================================================

# API-ключ DeepSeek (обязателен). Получить: https://platform.deepseek.com
DEEPSEEK_API_KEY=ваш_api_ключ_здесь

# Базовый адрес API (менять не требуется)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Модель по умолчанию: deepseek-v4-flash | deepseek-v4-pro
DEFAULT_MODEL=deepseek-v4-flash

# Температура по умолчанию (0.0 – 2.0)
DEFAULT_TEMPERATURE=0.7

# Максимальное число токенов ответа
DEFAULT_MAX_TOKENS=1000

# Системный промпт по умолчанию
DEFAULT_SYSTEM_PROMPT=Ты полезный AI-ассистент. Отвечай четко и по делу.

# Заголовок и размер окна
UI_TITLE=DeepSeek Chat
UI_WIDTH=900
UI_HEIGHT=700

# Mock-режим (true/false): имитация ответов без обращения к API —
# удобно для тестирования интерфейса без ключа
MOCK_MODE=false

# Ограничение истории: не более N последних сообщений диалога
MAX_HISTORY_MESSAGES=50

# Сохранение контекста между запусками (SQLite)
# STORAGE_ENABLED: true — история и параметры сохраняются в БД и
# восстанавливаются при перезапуске приложения
STORAGE_ENABLED=true
# Путь к файлу БД (относительно корня проекта)
STORAGE_PATH=data/chat_history.db

# --- Подсчёт токенов ---
# TOKENIZER_ENABLED: true — использовать tiktoken, если он установлен;
# false — всегда встроенная эвристика (без внешних зависимостей)
TOKENIZER_ENABLED=true
# Резервная кодировка tiktoken (у моделей DeepSeek своей кодировки нет)
TOKENIZER_ENCODING=cl100k_base

# --- Цены токенов (USD за 1M токенов) ---
# Если обе цены 0 — стоимость в UI не показывается («—»).
# Укажите актуальные цены для вашей модели (см. документацию DeepSeek).
PRICE_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0

# Необязательное переопределение цены для конкретной модели
# (имя модели в верхнем регистре, не-алфанумерические символы → «_»):
# PRICE_DEEPSEEK_V4_FLASH_INPUT_PER_1M=0.27
# PRICE_DEEPSEEK_V4_FLASH_OUTPUT_PER_1M=1.10
# PRICE_DEEPSEEK_V4_PRO_INPUT_PER_1M=0.55
# PRICE_DEEPSEEK_V4_PRO_OUTPUT_PER_1M=2.19

# --- Управление контекстом: сжатие старой части диалога в конспект (summary) ---
# Оставлено для обратной совместимости: в приложении не используется,
# в переключателе стратегий суммаризации нет (см. раздел «Стратегии» ниже).
# true — старые сообщения заменяются конспектом, последние N идут «как есть»
SUMMARY_ENABLED=true
# Сколько последних сообщений всегда отправляются без изменений
SUMMARY_KEEP_LAST_N=10
# Размер блока сжатия: столько «лишних» сообщений накопится — сжимаем
SUMMARY_EVERY_N=10
# Лимит длины конспекта в токенах
SUMMARY_MAX_TOKENS=400
# Температура служебного запроса сжатия
SUMMARY_TEMPERATURE=0.2
# Модель для сжатия (пусто — использовать модель диалога)
SUMMARY_MODEL=
# Свой промпт-инструкция для сжатия (пусто — встроенная)
SUMMARY_PROMPT=

# ============================================================
# Стратегии управления контекстом и ветки диалога
# ============================================================

# Стратегия по умолчанию — значение переключателя в интерфейсе:
#   sliding_window — в API уходят только последние WINDOW_KEEP_LAST_N
#                    сообщений (история при этом не удаляется: она видна
#                    в чате и восстанавливается при смене стратегии);
#   sticky_facts   — в API уходят блок фактов (ключ → значение) и последние
#                    WINDOW_KEEP_LAST_N сообщений; факты обновляются после
#                    каждого хода служебным запросом к модели;
#   branching      — режим веток диалога: checkpoint в любой точке, две
#                    независимые ветки от одного места, переключение между
#                    ними. Внутри ветки действует её подстратегия
#                    (sliding_window или sticky_facts).
STRATEGY=sliding_window

# Сколько последних сообщений диалога уходит в API (окно стратегии)
WINDOW_KEEP_LAST_N=20

# --- Sticky facts: блок «ключ → значение» ---
# true — обновлять факты служебным запросом к модели после каждого хода
# (+1 запрос на ход; его токены и стоимость считаются отдельными счётчиками)
FACTS_ENABLED=true
# Модель для извлечения фактов (пусто — модель диалога)
FACTS_MODEL=
# Температура служебного запроса извлечения фактов
FACTS_TEMPERATURE=0.0
# Лимит блока фактов в токенах (самые старые факты вытесняются)
FACTS_MAX_TOKENS=300
# Максимум пар «ключ → значение» в блоке фактов
FACTS_MAX_ITEMS=50
# Свой промпт-инструкция извлечения фактов (пусто — встроенная)
FACTS_PROMPT=

# --- Ветки диалога (режим branching) ---
# Максимальное число веток в одном хранилище
BRANCH_MAX=20

# ============================================================
# Модель памяти агента (short_term | working | long_term)
# ============================================================
# Три слоя памяти с явной семантикой (см. README «Модель памяти агента»):
#   short_term — сообщения активной ветки + закрепления (pin);
#   working    — состояние текущей задачи (цель/статус/план/ограничения/
#                вопросы + элементы key→value), привязана к ветке;
#   long_term  — глобальный профиль/решения/знания, отдельный файл
#                data/long_memory.db, переживает очистку истории и удаление БД чата.
# Запись в слои — только явно (кнопки у сообщений / окно «Память…» /
# подтверждение предложений). LLM лишь ПРЕДЛАГАЕТ кандидатов (pending).

# Общий выключатель модели памяти (false — поведение ровно как раньше)
MEMORY_ENABLED=true
# Рабочая память (задача, привязана к ветке)
MEMORY_WORKING_ENABLED=true
# Долговременная память (профиль/решения/знания)
MEMORY_LONG_ENABLED=true
# Путь к БД долговременной памяти (относительно корня проекта).
# Пустая строка — долговременный слой выключен.
MEMORY_LONG_PATH=data/long_memory.db
# Максимум записей долговременной памяти (самые старые вытесняются)
MEMORY_LONG_MAX_ITEMS=200
# Общий бюджет блоков памяти в запросе (токенов)
MEMORY_MAX_TOKENS=600
# Бюджет долговременной памяти в запросе
MEMORY_LONG_MAX_TOKENS=300
# Бюджет рабочей памяти в запросе
MEMORY_WORKING_MAX_TOKENS=250
# Максимум закреплённых сообщений (краткосрочная память)
MEMORY_PIN_MAX=5
# Предлагать классификацию после хода (один служебный LLM-запрос)
MEMORY_PROPOSE_LLM=true
# Модель служебного запроса классификации (пусто — модель диалога)
MEMORY_MODEL=
# Температура служебного запроса классификации
MEMORY_TEMPERATURE=0.0
# Свой промпт-инструкция классификации (пусто — встроенная)
MEMORY_PROMPT=
# Порог уверенности кандидатов классификации (0.0–1.0)
MEMORY_MIN_CONFIDENCE=0.6
# ВНИМАНИЕ: включать не рекомендуется — нарушает принцип явного выбора слоя.
# true — применять предложения LLM без подтверждения пользователя.
MEMORY_AUTO_APPLY=false
# Путь экспорта долговременной памяти по умолчанию
MEMORY_EXPORT_PATH=data/memory_export.md

# ============================================================
# Инварианты: пост-проверка ответов агента (второй LLM-вызов)
# ============================================================
# False — отключить пост-проверку ответов на нарушение инвариантов
ENABLE_POST_CHECK=true
# Лимит перегенераций при обнаружении нарушения (0–10)
MAX_REGENERATIONS=2
# Ответы короче этого числа символов не проверяются (экономия токенов)
MIN_RESPONSE_LENGTH=100

# ============================================================
# Явные переходы FSM задач
# ============================================================
# Лимит откатов validation → execution; после лимита задача FAILED
TASKS_MAX_RETRIES=3

# ============================================================
# MCP-клиент: панель инструментов сервера (stdio-транспорт)
# ============================================================
# False — панель MCP не создаётся
MCP_ENABLED=true
# Команда запуска MCP-сервера.
#
# Вариант 1 — собственный Git-сервер (без Node.js): my_git_server.py в
# корне проекта, инструменты get_git_log / get_git_status /
# get_git_branches над локальным git:
#   MCP_SERVER_COMMAND=python -u my_git_server.py
# Голый "python"/"python3" заменяется на интерпретатор приложения, а
# относительный *.py-путь в последнем аргументе разрешается от корня
# проекта — команда работает из любого рабочего каталога.
#
# Вариант 2 — коллекция открытых API open-internet-mcp (26 инструментов:
# wikipedia_summary, github_search, arxiv_search, open_meteo_forecast,
# usgs_quakes и др.; без ключей). Требуется Node.js (npx):
#   https://nodejs.org
MCP_SERVER_COMMAND=npx -y open-internet-mcp
# Таймаут handshake и tools/list|tools/call в секундах (1–600). Первый
# запуск npx скачивает пакет — может занять больше 30 секунд.
MCP_TIMEOUT=30
# Журнал MCP-клиента (события клиента и stderr сервера)
MCP_LOG_PATH=mcp.log
# Репозиторий по умолчанию для вызова get_git_* (подставляется в поле
# repo_path диалога «Вызвать»; пусто — корень проекта)
MCP_GIT_REPO_PATH=

# ============================================================
# MCP-сервер напоминаний (reminder_server.py, HTTP, 24/7)
# ============================================================
# False — без напоминаний (агент не получает tools напоминаний,
# сервер не запускается автоматически)
REMINDER_ENABLED=true
# Адрес сервера. ТОЛЬКО локальные значения (127.0.0.1/localhost/::1):
# хостить сервер в интернете нельзя
REMINDER_SERVER_HOST=127.0.0.1
# Порт http://127.0.0.1:<порт>/mcp
REMINDER_SERVER_PORT=8000
# Лимит циклов «LLM → tool_calls → результат → LLM» за один ход (1–20)
REMINDER_TOOLCALL_MAX_ROUNDS=5

# ============================================================
# MCP-сервер новостей (news_server.py, HTTP, 24/7):
# search_news (RSS) → summarize_text (DeepSeek) → save_to_file
# ============================================================
# False — без новостей (агент не получает tools новостей, сервер
# не запускается автоматически)
NEWS_ENABLED=true
# Адрес сервера (только локальные значения)
NEWS_SERVER_HOST=127.0.0.1
# Порт http://127.0.0.1:<порт>/mcp
NEWS_SERVER_PORT=8001
# Модель сводки summarize_text (пусто — deepseek-v4-flash)
NEWS_SUMMARY_MODEL=
# Лимит токенов сводки. ВАЖНО: thinking-модели тратят часть этого
# бюджета на reasoning, поэтому маленький лимит (например 1500) обрезает
# ответ (finish_reason=length). Дефолт 8000 — с запасом.
NEWS_SUMMARY_MAX_TOKENS=8000
# Папка результатов save_to_file (пусто — output/ в корне проекта)
NEWS_OUTPUT_DIR=
# RSS-ленты в формате "имя=url;имя=url". Если URL содержит шаблон
# {topic}, тема подставляется в запрос (поиск на стороне провайдера,
# локальный фильтр не применяется) — так подключается, например,
# Google News:
#   NEWS_RSS_FEEDS=google=https://news.google.com/rss/search?q={topic}&hl=ru&gl=RU&ceid=RU:ru
# (пусто — встроенные: google + cnews + 3dnews + habr + kommersant +
#  lenta)
NEWS_RSS_FEEDS=

# ============================================================
# MCP-сервер геолокации (geo_server.py, HTTP, 24/7):
# get_user_city — город пользователя по IP (ip-api.com, без ключа,
# лимит 45 запросов/мин). Первое звено цепочки «гео → погода»:
# LLM сама вызывает get_user_city → get_weather(city).
# ============================================================
# False — без geo-инструмента (сервер не запускается автоматически)
GEO_ENABLED=true
# Адрес сервера (только локальные значения)
GEO_SERVER_HOST=127.0.0.1
# Порт http://127.0.0.1:<порт>/mcp (8001 занят news-сервером)
GEO_SERVER_PORT=8002

# ============================================================
# MCP-сервер погоды (weather_server.py, HTTP, 24/7):
# get_weather(city) — текущая погода (Open-Meteo, без API-ключа;
# два шага: геокодинг → прогноз). Второе звено цепочки «гео → погода».
# ============================================================
# False — без погоды (сервер не запускается автоматически)
WEATHER_ENABLED=true
# Адрес сервера (только локальные значения)
WEATHER_SERVER_HOST=127.0.0.1
# Порт http://127.0.0.1:<порт>/mcp
WEATHER_SERVER_PORT=8003

# Мелкие настройки UI (сворачивание панели MCP) — SQLite key-value
APP_STATE_PATH=data/app_state.db

# ============================================================
# RAG (Flet-приложение app/main.py): база знаний на MD-документах.
# Эмбеддинги считаются ЛОКАЛЬНО через Ollama (облачных нет — по ТЗ).
# Сервис: ollama serve; модель: ollama pull nomic-embed-text
# ============================================================
# Базовый URL локальной Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Модель эмбеддингов (префиксы search_document:/search_query: обязательны)
OLLAMA_EMBED_MODEL=nomic-embed-text
